# Environment variables for Universal Text-to-SQL Agent

# Groq API Key (required) - get from https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Database connection (defaults to in-memory SQLite demo if not set)
# SQLite examples:
#   DATABASE_URL=sqlite:///./mydb.sqlite3
#   DATABASE_URL=sqlite:///:memory:
# PostgreSQL example:
#   DATABASE_URL=postgresql://user:password@localhost:5432/mydb
# MySQL example:
#   DATABASE_URL=mysql+pymysql://user:password@localhost:3306/mydb
DATABASE_URL=sqlite:///:memory:

# Groq model to use (default: llama-3.3-70b-versatile)
GROQ_MODEL=llama-3.3-70b-versatile

# Maximum SQL generation retries via self-reflection
MAX_RETRIES=3

# Enable query memory / RL-inspired few-shot learning (true/false)
ENABLE_QUERY_MEMORY=true
