# Environment variables for Universal Text-to-SQL Agent

# Which LLM provider to use: groq (default) | openai | anthropic | ollama.
# Provider SDKs beyond Groq are optional extras -- install with
# pip install universal-text2sql[openai|anthropic|ollama|all-providers].
LLM_PROVIDER=groq

# Groq API Key (required when LLM_PROVIDER=groq) - get from https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Database connection (defaults to in-memory SQLite demo if not set)
# SQLite examples:
#   DATABASE_URL=sqlite:///./mydb.sqlite3
#   DATABASE_URL=sqlite:///:memory:
# PostgreSQL example:
#   DATABASE_URL=postgresql://user:password@localhost:5432/mydb
# MySQL example:
#   DATABASE_URL=mysql+pymysql://user:password@localhost:3306/mydb
DATABASE_URL=sqlite:///:memory:

# Groq model to use (default: llama-3.3-70b-versatile)
GROQ_MODEL=llama-3.3-70b-versatile

# Alternative provider settings (only used when LLM_PROVIDER selects them):
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# ANTHROPIC_MODEL=claude-3-5-sonnet-latest
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.1

# Maximum SQL generation retries via self-reflection
MAX_RETRIES=3

# Enable query memory / RL-inspired few-shot learning (true/false)
ENABLE_QUERY_MEMORY=true

# Enable LLM-assisted business glossary generation (true/false).
# Heuristic descriptions are always generated; this adds an LLM pass
# (one call per table, cached to disk) for richer descriptions/synonyms.
ENABLE_METADATA_ENRICHMENT=true

# Directory where the auto-generated metadata/glossary cache is stored
METADATA_CACHE_DIR=./.metadata_cache

# Number of SQL candidates to sample for non-trivial questions and pick
# the majority-vote (self-consistency) result. 1 disables self-consistency.
SELF_CONSISTENCY_SAMPLES=1

# Route COMPLEX questions through DIN-SQL-style decomposition (break into
# ordered sub-questions, generate SQL per sub-question, compose via CTEs)
# instead of single-shot generation (true/false). Mutually exclusive with
# self-consistency sampling for a given question.
ENABLE_QUERY_DECOMPOSITION=false

# Enforce read-only SQL by default (true/false). When true (the default),
# LLM-generated INSERT/UPDATE/DELETE/DDL statements are blocked before
# execution; use DatabaseConnector(read_only=False) or
# execute_query(..., enforce_read_only=False) to opt into writes for a
# specific call/connector. See universal_text2sql/database/safety.py.
SQL_READ_ONLY=true

# Best-effort wall-clock timeout (seconds) applied to every query. Unset
# (default) means no timeout. Does not guarantee true statement
# cancellation on every backend -- see safety.run_with_timeout's docstring.
SQL_STATEMENT_TIMEOUT_SECONDS=

# Enable value/entity grounding (true/false). Profiles low-cardinality text
# columns once at bootstrap (cached to disk) and matches question terms
# against real stored values, so filter literals (e.g. "usa" -> "USA") are
# grounded instead of guessed. See universal_text2sql/knowledge/grounding.py.
ENABLE_VALUE_GROUNDING=true

# Directory where the value-grounding profile cache is stored
GROUNDING_CACHE_DIR=./.grounding_cache

# Never profile a table with more rows than this (cost ceiling)
GROUNDING_MAX_TABLE_ROWS=200000

# Never treat a column as categorical if it has more distinct values than this
GROUNDING_MAX_DISTINCT=500

# A column is "categorical" when distinct_count/row_count is below this ratio
GROUNDING_CARDINALITY_RATIO=0.75
